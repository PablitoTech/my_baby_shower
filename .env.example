# ------------------------------------------------------------------
# My Baby Shower — variables de entorno de ejemplo
# Local:  cp .env.example .env   (.env no se versiona)
# Vercel: define estas mismas variables en Project Settings → Environment Variables
# ------------------------------------------------------------------

# ---- Base de datos (obligatoria) -----------------------------------
# PostgreSQL gestionado (Aiven, Neon, Supabase…). `schema` aísla las tablas
# del proyecto; `sslmode=require` cifra la conexión.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=my_baby_shower&sslmode=require"

# Alternativa local con Docker (npm run db:up):
# DATABASE_URL="postgresql://polcrez:12345@localhost:5432/my_baby_shower?schema=public"

# Opcional: certificado CA del proveedor en PEM (saltos de línea como \n).
# Si se define, además de cifrar se verifica el certificado del servidor.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Opcional: conexiones máximas por instancia (serverless: valores bajos)
# DATABASE_POOL_MAX=5

# ---- PostgreSQL local con Docker (db:up) y pruebas de integración ----
# Las pruebas crean <DB_NAME>_test en este PostgreSQL local; nunca tocan DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=polcrez
DB_PASSWORD=12345
DB_NAME=my_baby_shower
DB_SCHEMA=public

# ---- Aplicación ----------------------------------------------------
NODE_ENV=development
# URL pública (enlaces de recuperación de contraseña). En Vercel: https://tu-dominio.vercel.app
APP_URL=http://localhost:3000
# Genera uno propio: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
