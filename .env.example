# ------------------------------------------------------------------
# My Baby Shower — plantilla de variables de entorno
#
# Perfiles locales (no se versionan), uno por entorno:
#   cp .env.example .env.development   → npm run dev (PostgreSQL local con Docker)
#   cp .env.example .env.test          → npm run test:integration (PostgreSQL local, base *_test)
#   cp .env.example .env.production    → npm run build / start y comandos :prod (Aiven)
#
# El perfil se elige con APP_ENV (development | test | production); si no se
# define, se deduce de NODE_ENV. En Vercel define estas variables en
# Project Settings → Environment Variables (no se usan archivos).
# ------------------------------------------------------------------

# ---- Base de datos (obligatoria) -----------------------------------
# dev:  postgresql://polcrez:12345@localhost:5432/my_baby_shower?schema=public
# test: postgresql://polcrez:12345@localhost:5432/my_baby_shower_test?schema=public
# prod: PostgreSQL gestionado (Aiven) con sslmode=require
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=my_baby_shower&sslmode=require"

# Opcional: certificado CA del proveedor en PEM (saltos de línea como \n).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Opcional: conexiones máximas por instancia (serverless: valores bajos)
# DATABASE_POOL_MAX=5

# ---- Aplicación ----------------------------------------------------
# URL pública (enlaces de recuperación de contraseña)
APP_URL=http://localhost:3000
# Un secreto distinto por perfil: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# ---- Solo .env.test -------------------------------------------------
# RATE_LIMIT_DISABLED=true

# ---- Solo .env.development: PostgreSQL local con Docker (npm run db:up) ----
# DATABASE_URL="postgresql://polcrez:12345@localhost:5432/my_baby_shower?schema=public"
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=polcrez
# DB_PASSWORD=12345
# DB_NAME=my_baby_shower
# DB_SCHEMA=public
