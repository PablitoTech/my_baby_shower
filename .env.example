# ------------------------------------------------------------------
# my_baby_shower — variables de entorno de ejemplo
# Copia este archivo como environment.m y ajusta los valores:
#   cp .env.example environment.m
# Las credenciales indicadas son SOLO para desarrollo local.
# ------------------------------------------------------------------

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=polcrez
DB_PASSWORD=12345
DB_NAME=my_baby_shower
DB_SCHEMA=public

# Cadena de conexión consumida por Prisma
DATABASE_URL=postgresql://polcrez:12345@localhost:5432/my_baby_shower?schema=public

# Backend
NODE_ENV=development
API_PORT=3000
FRONTEND_URL=http://localhost:4200

# Autenticación (genera valores aleatorios con: openssl rand -base64 48)
JWT_ACCESS_SECRET=cambia-este-valor-por-uno-aleatorio-largo
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
