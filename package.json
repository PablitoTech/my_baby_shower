{
  "name": "my_baby_shower",
  "version": "0.2.0",
  "description": "Plataforma web para organizar Baby Showers y gestionar listas de regalos.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "libs/common",
    "libs/contracts",
    "libs/shared",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @mbs/web",
    "build": "npm run build -w @mbs/web",
    "start": "npm run start -w @mbs/web",
    "typecheck": "npm run typecheck -w @mbs/web",
    "test": "npm run test -w @mbs/web",
    "test:integration": "npm run test:integration -w @mbs/web",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down",
    "db:status": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env ps",
    "db:logs": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env logs -f postgres",
    "db:psql": "docker exec -it my_baby_shower_postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:destroy": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down -v",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
